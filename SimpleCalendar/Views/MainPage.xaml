<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimpleCalendar.Views.MainPage"
             Title="Мой Календарь"
             BackgroundColor="#F5F5F7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Выбор даты -->
            <Frame CornerRadius="12" Padding="10" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Выберите дату:" FontSize="14" TextColor="Gray" />
                    <DatePicker x:Name="datePicker" 
                                FontSize="18" 
                                Format="dd MMMM yyyy" 
                                DateSelected="OnDateSelected" />
                </VerticalStackLayout>
            </Frame>

            <!-- Кнопки быстрых действий -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" 
                        Text="+ Заметка" 
                        Clicked="AddNote_Clicked" 
                        BackgroundColor="#512BD4" 
                        TextColor="White" 
                        CornerRadius="10" />

                <Button Grid.Column="1" 
                        Text="+ Событие" 
                        Clicked="AddEvent_Clicked" 
                        BackgroundColor="#2B0B98" 
                        TextColor="White" 
                        CornerRadius="10" />
            </Grid>

            <!-- Заголовок списка -->
            <Label x:Name="selectedDateLabel" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="#333333" 
                   Margin="0,10,0,0" />

            <!-- Список заметок/событий -->
            <CollectionView x:Name="itemsCollectionView" HeightRequest="300">
                <CollectionView.EmptyView>
                    <Label Text="На эту дату пока ничего не запланировано" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           TextColor="Gray" 
                           Margin="0,30,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="12" CornerRadius="10" BackgroundColor="White" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#111111" />
                                    <Label Text="{Binding TimeText}" FontSize="13" TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1" 
                                        Text="✕" 
                                        TextColor="Red" 
                                        BackgroundColor="Transparent" 
                                        FontSize="18"
                                        Clicked="DeleteKey_Clicked" 
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>